# Omii Backend Server Environment Variables
PORT=3001
NODE_ENV=development
SITE_NAME=Omii
FULL_TITLE=Omii: Anonymous Stranger Chat
CORS_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=admin
ADMIN_SECRET=admin
JWT_SECRET=omii-super-secret-key-change-in-production
DATABASE_URL=file:./dev.db

# Cloud Storage Option 1: Supabase Storage
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_UPLOADS_BUCKET=uploads
SUPABASE_STORAGE_BUCKET=reports

# Cloud Storage Option 2: S3 / S3-Compatible Cloud Storage (Auto-configured on platforms with S3)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
