# ================================================================
# OmiiChat - Environment Configuration Template
# ================================================================
# Copy this file to .env or configure respective subdirectories:
# - Backend configuration: server/.env
# - Frontend configuration: web/.env.local

# --- Backend Server Configuration (server/.env) ---
PORT=3001
NODE_ENV=development
SITE_NAME=Omii
FULL_TITLE=Omii: Anonymous Stranger Chat
CORS_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_SECRET=change_this_admin_secret_in_production
JWT_SECRET=your_super_secret_jwt_key_here
DATABASE_URL=file:./dev.db

# --- Optional Cloud Storage (Supabase Storage) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_UPLOADS_BUCKET=uploads
SUPABASE_STORAGE_BUCKET=reports

# --- Optional Cloud Storage (AWS S3 / Cloudflare R2) ---
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_ENDPOINT_URL_S3=https://s3.amazonaws.com
AWS_REGION=us-east-1

# --- Frontend Web Application (web/.env.local) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
